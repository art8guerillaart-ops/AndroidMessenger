# Скопируй этот файл в .env и заполни своими данными.
# Файл .env НЕ должен попадать в git (добавь его в .gitignore).

# --- SMTP для отправки кодов подтверждения на email ---
# Если оставить пустым — коды будут просто печататься в консоль (режим разработки).

# Вариант 1: Gmail
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=твой_email@gmail.com
#   SMTP_PASSWORD=пароль_приложения (НЕ обычный пароль!)
#   Как получить пароль приложения: myaccount.google.com -> Безопасность ->
#   Двухэтапная аутентификация -> Пароли приложений

# Вариант 2: транзакционный email-сервис (рекомендуется для реального продукта —
# лучше доставляемость и не блокируют как "спам-рассылку" с личной почты)
#   Resend: smtp.resend.com, порт 587, user "resend", password — твой API-ключ
#   Brevo (ex-Sendinblue): smtp-relay.brevo.com, порт 587
#   Postmark: smtp.postmarkapp.com, порт 587
#   Mailgun: smtp.mailgun.org, порт 587

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=твой_api_ключ
SMTP_FROM=onboarding@resend.dev
SMTP_USE_SSL=true